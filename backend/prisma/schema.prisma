generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ================= ENUMS =================
 */

enum UserRole {
  MEMBER
  DORMITORY_STAFF
  ADMIN
  OWNER
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RentalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum ContractStatus {
  DRAFT
  WAITING_OWNER_APPROVAL
  ACTIVE
  REJECTED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SLIP_UPLOADED
  VERIFYING
  VERIFIED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum PaymentType {
  BANK
  PROMPTPAY
}

enum DormitoryStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketType {
  GENERAL
  PAYMENT
  MAINTENANCE
  COMPLAINT
}

/**
 * ================= MODELS =================
 */

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  role      UserRole @default(MEMBER)
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  universityId Int?
  university   University? @relation(fields: [universityId], references: [id])

  rentalRequests RentalRequest[]
  leaseContracts LeaseContract[]
  reviews        Review[]

  owner             Owner?
  ownerApplications OwnerApplication[]

  memberTickets Ticket[] @relation("MemberTickets")
  ownerTickets  Ticket[] @relation("OwnerTickets")

  messages      Message[]

  @@index([role])
}

model University {
  id          Int      @id @default(autoincrement())
  name        String
  shortName   String?
  province    String?
  latitude    Float
  longitude   Float
  source      String   @default("seed")
  searchCount Int      @default(0)
  createdAt   DateTime @default(now())

  users User[]

  @@unique([name, latitude, longitude])
}

model Owner {
  id     Int @id @default(autoincrement())
  userId Int @unique

  firstName String
  lastName  String
  phone     String
  email     String

  idCardImage     String?
  businessLicense String?

  /**
   * ================= PAYMENT =================
   */

  paymentType PaymentType @default(BANK)

  promptPayId String? // 🔐 encrypted (phone / citizen id)

  bankName        String?
  bankAccountName String?
  bankAccountNo   String? // 🔐 encrypted

  /**
   * ================= STATUS =================
   */

  isActive   Boolean   @default(true)
  verifiedAt DateTime?

  /**
   * ================= META =================
   */

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  dormitories Dormitory[]
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Dormitory {
  id        Int     @id @default(autoincrement())
  name      String
  address   String
  type      String
  location  String?
  latitude  Float?
  longitude Float?

  /* ================= STATUS ================= */

  status      DormitoryStatus @default(PENDING)
  approvedAt  DateTime?
  rejectedAt  DateTime?
  approvedBy  Int?  // admin userId
  rejectionNote String?

  /* ================= RELATIONS ================= */

  ownerId Int
  owner   Owner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  rooms   Room[]
  reviews Review[]
  images  DormitoryImage[]

  @@index([status])
  @@index([ownerId])
}

model DormitoryImage {
  id          Int       @id @default(autoincrement())
  imageUrl    String
  dormitoryId Int
  dormitory   Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)
}

model Room {
  id          Int        @id @default(autoincrement())
  roomNumber  String
  price       Decimal    @db.Decimal(10, 2)
  size        Float
  status      RoomStatus @default(AVAILABLE)
  floor       Int
  capacity    Int
  dormitoryId Int

  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  images RoomImage[]   // room gallery

  rentalRequests RentalRequest[]
  leaseContracts LeaseContract[]

  @@unique([dormitoryId, roomNumber])
  @@index([status])
}

model RoomImage {
  id       Int    @id @default(autoincrement())
  imageUrl String

  roomId Int
  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model RentalRequest {
  id          Int          @id @default(autoincrement())
  requestDate DateTime     @default(now())
  status      RentalStatus @default(PENDING)
  userId      Int
  roomId      Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  leaseContract LeaseContract?

  @@index([userId])
  @@index([roomId])
}

model LeaseContract {
  id          Int            @id @default(autoincrement())
  startDate   DateTime
  endDate     DateTime
  duration    Int            @default(6) // 6 หรือ 12 เดือน
  monthlyRent Decimal        @db.Decimal(10, 2)
  deposit     Decimal        @db.Decimal(10, 2)
  status      ContractStatus @default(DRAFT)

  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userId    Int
  roomId    Int
  requestId Int @unique

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  room    Room          @relation(fields: [roomId], references: [id])
  request RentalRequest @relation(fields: [requestId], references: [id])

  payments Payment[]

  tickets Ticket[]

  @@index([userId])
  @@index([roomId])
}

model Payment {
  id           Int       @id @default(autoincrement())
  billingMonth DateTime
  amount       Decimal   @db.Decimal(10, 2)
  dueDate      DateTime
  paidAt       DateTime?

  status PaymentStatus @default(PENDING)

  slipImageUrl   String?
  imageHash      String? @unique
  transactionRef String? @unique

  receiverName    String?
  receiverAccount String?
  bankName        String?

  qrPayload String? // 🔥 raw EMV payload
  qrImage   String? // 🔥 base64 image

  verifiedByAI     Boolean @default(false)
  verificationNote String?

  confirmedByOwner Boolean   @default(false)
  ownerConfirmAt   DateTime?
  ownerNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contractId Int
  contract   LeaseContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, billingMonth])
  @@index([contractId])
}

model Review {
  id          Int      @id @default(autoincrement())
  rating      Int
  comment     String
  reviewDate  DateTime @default(now())
  userId      Int
  dormitoryId Int

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dormitory Dormitory @relation(fields: [dormitoryId], references: [id], onDelete: Cascade)

  @@index([userId, dormitoryId])
}

model OwnerApplication {
  id     Int @id @default(autoincrement())
  userId Int

  /**
   * =====================
   * Personal Information
   * =====================
   */
  firstName String
  lastName  String
  phone     String
  email     String

  /**
   * =====================
   * Bank Information
   * =====================
   */
  bankName        String?
  bankAccountName String?
  bankAccountNo   String?

  /**
   * =====================
   * Documents (NEW)
   * =====================
   */
  idCardImage     String?
  businessLicense String?

  /**
   * =====================
   * Application Detail
   * =====================
   */
  message String?
  status  ApplicationStatus @default(PENDING)

  reviewedAt DateTime?
  reviewedBy Int?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
}

model Ticket {
  id          Int      @id @default(autoincrement())

  contractId  Int
  memberId    Int
  ownerId     Int

  title       String
  type        TicketType
  status      TicketStatus @default(OPEN)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contract    LeaseContract @relation(fields: [contractId], references: [id])
  member      User          @relation("MemberTickets", fields: [memberId], references: [id])
  owner       User          @relation("OwnerTickets", fields: [ownerId], references: [id])

  messages    Message[]
  attachments TicketAttachment[]

  @@index([contractId])
  @@index([memberId])
  @@index([ownerId])
}

model Message {
  id        Int      @id @default(autoincrement())

  ticketId  Int
  senderId  Int

  message   String
  read      Boolean  @default(false)

  createdAt DateTime @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id])
  sender    User   @relation(fields: [senderId], references: [id])
}

model TicketAttachment {
  id        Int      @id @default(autoincrement())

  ticketId  Int
  fileUrl   String

  createdAt DateTime @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id])
}
